{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "client-api4001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191,
      "env": {
        "API_PROXY": "http://localhost:4001"
      }
    }
  ]
}
