{
  "name": "shieor-server",
  "version": "1.0.0",
  "description": "API backend for Shieor",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "dev:safe": "set DISABLE_WHATSAPP=1&& set NODE_OPTIONS=--max-old-space-size=4096&& nodemon app.js",
    "seed": "node seed.js",
    "seed:big": "node seedBig.js",
    "qa:reservations:smoke": "node scripts/stage3ReservationsSmoke.mjs",
    "qa:reservations:integration": "node scripts/stage4ReservationsIntegration.mjs",
    "qa:frontdesk": "node scripts/frontdeskIntegration.mjs",
    "qa:departures": "node scripts/departureIntegration.mjs",
    "qa:ops": "node scripts/opsIntegration.mjs",
    "qa:finance": "node scripts/financeIntegration.mjs",
    "qa:booking": "node scripts/bookingIntegration.mjs",
    "qa:stay": "node scripts/stayIntegration.mjs",
    "qa:readiness:room-moves": "node scripts/roomMoveReadiness.mjs",
    "qa:readiness:room-swaps": "node scripts/roomSwapReadiness.mjs",
    "qa:readiness:arrivals": "node scripts/arrivalReadiness.mjs",
    "qa:readiness:arrival-display": "node scripts/arrivalDisplayReadiness.mjs",
    "qa:readiness:cribs": "node scripts/cribReadiness.mjs",
    "qa:readiness:parties": "node scripts/partyReadiness.mjs",
    "qa:readiness:lifecycle": "node scripts/lifecycleReadiness.mjs",
    "qa:readiness:stay-closure": "node scripts/stayClosureReadiness.mjs",
    "qa:readiness:departures": "node scripts/departureReadiness.mjs",
    "qa:readiness:business-day": "node scripts/businessDayReadiness.mjs",
    "qa:readiness:business-day-migration": "node scripts/businessDayMigrationReadiness.mjs",
    "qa:departures:isolated": "node scripts/stayIsolatedRegression.mjs departure",
    "qa:finance:isolated": "node scripts/stayIsolatedRegression.mjs finance",
    "qa:booking:isolated": "node scripts/stayIsolatedRegression.mjs booking",
    "qa:frontdesk:isolated": "node scripts/stayIsolatedRegression.mjs frontdesk",
    "qa:stay:isolated": "node scripts/stayIsolatedRegression.mjs",
    "qa:identity": "node scripts/identityIntegration.mjs",
    "qa:platform": "node scripts/platformIntegration.mjs",
    "qa:books": "node scripts/booksIntegration.mjs",
    "qa:groups": "node scripts/groupBillingIntegration.mjs",
    "qa:documents": "node scripts/documentsIntegration.mjs",
    "qa:fiscal": "node scripts/fiscalIntegration.mjs",
    "qa:invoicer": "node scripts/invoicerIntegration.mjs",
    "qa:fiscal:unit": "node --test scripts/fiscalTransaction.test.mjs scripts/accountingDomain.test.mjs",
    "qa:accounting": "node --test scripts/accountingIntegration.test.mjs",
    "qa:accounting:regression": "node scripts/accountingRegression.mjs",
    "qa:accounting:preview": "node scripts/accountingPreviewServer.mjs",
    "qa:accounting:inventory": "node scripts/accountingInventory.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.4.24",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "moment": "^2.30.1",
    "mongoose": "^9.6.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.2"
  },
  "config": {
    "mongodbMemoryServer": { "disablePostinstall": true, "version": "7.0.14" }
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11"
  }
}
